# CDBoost CMake Package Configuration

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Boost REQUIRED COMPONENTS rational)
find_dependency(spdlog CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/cdboostTargets.cmake")

check_required_components(cdboost)
